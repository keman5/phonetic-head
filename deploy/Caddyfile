test.upit.top:443 {
    tls internal
    root * /etc/caddy/phonetic-head/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Permissions-Policy "camera=(), microphone=(self)"
        Cache-Control no-cache
    }
    @private path */.*
    respond @private 404
    handle /api/* {
        reverse_proxy 127.0.0.1:4174
    }
    handle /admin {
        redir /admin.html 302
    }
    handle {
        file_server {
            precompressed br gzip
        }
    }
}

http://test.upit.top {
    redir https://test.upit.top{uri} 308
}
