# Copy to .env locally. Never put a key in browser JavaScript.
# Without a key, all offline lessons and recording comparison still work.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4.1-mini
AI_TRANSCRIBE_MODEL=whisper-1
PORT=4173

# Course management. TTS keys are configured in /admin.html and stored server-side.
# Persistent directory must be outside deployment releases.
# DATA_DIR=/var/lib/phonetic-head
# PUBLIC_ORIGIN=https://test.upit.top
